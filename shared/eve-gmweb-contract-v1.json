{
  "version": 4,
  "consumer": "eve",
  "projectKeyDefaults": {
    "scopes": [
      "sms.send",
      "sms.status",
      "sms.cancel",
      "sms.capacity",
      "sms.invalidate",
      "transport:read"
    ],
    "ingressRatePerMinute": 30,
    "ingressRatePerHour": 1000
  },
  "transport": {
    "schemes": [
      "http",
      "https"
    ],
    "recommendedScheme": "https",
    "plaintextWarnHosts": "non-local",
    "authHeader": "Authorization: Bearer <projectKey>",
    "idempotencyHeader": "Idempotency-Key",
    "acceptHeader": "application/json",
    "contentType": "application/json",
    "timeoutSeconds": {
      "default": 15,
      "min": 3,
      "max": 90,
      "statusPollMax": 5
    },
    "retry": {
      "attempts": 2,
      "onlyWithIdempotencyKey": true,
      "retriesOn": [
        "timeout",
        "connection_error",
        "5xx"
      ]
    }
  },
  "endpoints": [
    {
      "key": "ready",
      "method": "GET",
      "path": "/ready",
      "scope": "sms.capacity"
    },
    {
      "key": "send",
      "method": "POST",
      "path": "/send",
      "scope": "sms.send"
    },
    {
      "key": "send_status",
      "method": "GET",
      "path": "/send/status/{requestId}",
      "scope": "sms.status"
    },
    {
      "key": "send_cancel",
      "method": "POST",
      "path": "/send/cancel/{requestId}",
      "scope": "sms.cancel"
    },
    {
      "key": "send_capacity",
      "method": "GET",
      "path": "/send/capacity",
      "scope": "sms.capacity"
    },
    {
      "key": "post_invalidate",
      "method": "POST",
      "path": "/send/invalidate",
      "scope": "sms.invalidate"
    },
    {
      "key": "transport_health",
      "method": "GET",
      "path": "/eve/v1/transport-health",
      "scope": "transport:read"
    }
  ],
  "sendRequest": {
    "required": [
      "to",
      "text",
      "priority"
    ],
    "priorityLanes": {
      "critical": 1,
      "expired": 3,
      "expiring": 6,
      "announcement": 10
    },
    "meta": {
      "description": "Optional consumer notification identity. The gateway stores it with the queued message so a later lifecycle invalidation can revoke exactly this reminder.",
      "fields": {
        "source": "string (max 32) - consumer key, 'eve'",
        "serviceKey": "string (max 200) - 'eve:<serverId>:<clientUuid>'",
        "notificationKind": "near_expiry|low_volume|expired|volume_ended|created|renew",
        "generation": "integer >= 0 - the service lifecycle generation this message was computed from",
        "correlationId": "string (max 64)",
        "requiresValidation": "boolean - true for every automated depletion reminder, false for transactional created/renew confirmations"
      },
      "invalidationEligibleKinds": [
        "near_expiry",
        "low_volume",
        "expired",
        "volume_ended"
      ]
    }
  },
  "sendResponse": {
    "acceptedStatus": [
      200,
      202
    ],
    "fields": {
      "requestId": "string",
      "jobId": "string|integer",
      "status": "sent|completed|unverified|failed|cancelled|superseded|duplicate_suppressed",
      "statusUrl": "string (relative to the gateway origin)",
      "terminal": "boolean",
      "successful": "boolean",
      "retryAfterSeconds": "integer",
      "superseded": "boolean - a lifecycle invalidation made this notification stale"
    },
    "terminalStatuses": [
      "sent",
      "completed",
      "unverified",
      "failed",
      "cancelled",
      "superseded"
    ],
    "nonBillableTerminalStatuses": [
      "cancelled",
      "superseded",
      "suppressed"
    ]
  },
  "capacityResponse": {
    "required": [
      "announcement"
    ],
    "announcementFields": [
      "limit",
      "pending",
      "available",
      "recommendedBatchSize"
    ]
  },
  "invalidationRequest": {
    "required": [
      "source",
      "serviceKey"
    ],
    "fields": {
      "source": "string (max 32)",
      "serviceKey": "string (max 200)",
      "currentGeneration": "integer >= 0 - the generation the renewal committed",
      "invalidateKinds": [
        "near_expiry",
        "low_volume",
        "expired",
        "volume_ended"
      ],
      "reason": "string (max 64) - e.g. renewed",
      "correlationId": "string (max 64)",
      "eventId": "string (max 200) - stable id for this lifecycle transition; the request is idempotent on it"
    },
    "semantics": [
      "Cancels every not-yet-started send whose meta.source and meta.serviceKey match and whose meta.notificationKind is in invalidateKinds (all kinds when the list is empty).",
      "A send that already started is revoked (signalled to stop), not deleted; nothing can recall an SMS the phone already delivered.",
      "currentGeneration is a monotonic per-service watermark: a request carrying a generation lower than one already recorded is refused with 409 stale_generation, so a delayed invalidation can never cancel a newer lifecycle's reminder.",
      "Repeating the same eventId replays the original response and changes nothing."
    ]
  },
  "invalidationResponse": {
    "acceptedStatus": [
      200
    ],
    "ok": true,
    "fields": {
      "ok": "boolean",
      "currentGeneration": "integer",
      "cancelledPending": "integer",
      "revokedActive": "integer",
      "revokedInflight": "integer",
      "alreadyTerminal": "integer",
      "matched": "integer",
      "replayed": "boolean"
    },
    "conflictStatus": 409,
    "conflictErrors": [
      "stale_generation"
    ],
    "example": {
      "ok": true,
      "currentGeneration": 18,
      "cancelledPending": 2,
      "revokedActive": 1,
      "revokedInflight": 1,
      "alreadyTerminal": 0
    }
  },
  "transportHealthResponse": {
    "contractVersion": 1,
    "endpoint": "transport_health",
    "description": "GMweb's self-report of the ACTIVE delivery transport. This body can only ever describe GMweb's own state; it can never describe whether the consumer reached GMweb. Reachability, authentication, scope and contract availability are the CONSUMER's probe result (see probeStates), never fields in this body.",
    "topLevel": [
      "contract_version",
      "observed_at",
      "gmweb",
      "transport",
      "device",
      "queue",
      "last_ack",
      "diagnostics"
    ],
    "sections": {
      "gmweb": ["ready", "reason"],
      "transport": ["active", "mode", "state", "reason"],
      "device": ["state", "reason", "last_seen_at", "last_seen_age_ms", "age_ms"],
      "queue": ["pending", "inflight"],
      "last_ack": ["at", "outcome"],
      "diagnostics": ["androidPull"]
    },
    "fieldSemantics": {
      "gmweb.ready": "The ACTIVE delivery transport is ready. It does NOT mean 'GMweb is reachable' - a 200 answer already proves reachability.",
      "gmweb.reason": "The actionable reason the gateway is not ready: the operational reason (work is waiting on a device) when there is one, otherwise the transport's own machine reason.",
      "transport.state": "The active transport's machine state.",
      "transport.reason": "The active transport's own machine reason.",
      "device.last_seen_at": "Most recent presence signal for the ACTIVE transport's device.",
      "device.last_seen_age_ms": "Age of device.last_seen_at in milliseconds. Null when there has never been a presence signal or the active transport has no presence concept."
    },
    "deprecatedAliases": {
      "device.age_ms": "Alias of device.last_seen_age_ms, kept so that a provider-first or consumer-first rollout cannot silently drop the field. Consumers MUST read last_seen_age_ms."
    },
    "deviceSemantics": [
      "device describes the device of the ACTIVE transport and nothing else.",
      "transport.active=android with transport.mode=pull: last_seen_at/last_seen_age_ms are the most recent Android pull and device.state is the pull bridge's state.",
      "transport.active=chrome: Chrome has no pull presence, so last_seen_at and last_seen_age_ms are null and device.state is Chrome's pairing state. Android presence MUST NOT be promoted into these fields.",
      "A non-active Android bridge is reported only under diagnostics.androidPull, marked authoritative=false."
    ],
    "forbiddenFields": [
      "deviceKey",
      "masterToken",
      "apiKey",
      "to",
      "text",
      "phoneNumber",
      "conversationId",
      "conversation"
    ],
    "states": [
      "connected",
      "stale",
      "unconfigured",
      "push_unreachable",
      "not_paired",
      "unknown"
    ],
    "reasons": [
      "no_recent_device_pull",
      "device_key_not_configured",
      "android_gateway_unreachable",
      "android_gateway_not_configured",
      "chrome_not_paired",
      "chrome_probe_failed",
      "pull_bridge_unavailable",
      "task_waiting_no_device",
      "inflight_device_stale"
    ],
    "probeStates": [
      "connected",
      "gmweb_not_configured",
      "gmweb_unreachable",
      "contract_missing",
      "contract_version_mismatch",
      "auth_failed",
      "scope_denied",
      "invalid_response"
    ],
    "samples": {
      "android_pull_connected": {
        "contract_version": 1,
        "observed_at": "2026-09-26T19:03:48.000Z",
        "gmweb": { "ready": true, "reason": null },
        "transport": { "active": "android", "mode": "pull", "state": "connected", "reason": null },
        "device": {
          "state": "connected",
          "reason": null,
          "last_seen_at": "2026-09-26T19:03:45.000Z",
          "last_seen_age_ms": 3000,
          "age_ms": 3000
        },
        "queue": { "pending": 4, "inflight": 1 },
        "last_ack": { "at": "2026-09-26T19:03:41.000Z", "outcome": "completed" },
        "diagnostics": { "androidPull": null }
      },
      "android_pull_stale": {
        "contract_version": 1,
        "observed_at": "2026-09-26T19:03:48.000Z",
        "gmweb": { "ready": false, "reason": "no_recent_device_pull" },
        "transport": { "active": "android", "mode": "pull", "state": "stale", "reason": "no_recent_device_pull" },
        "device": {
          "state": "stale",
          "reason": "no_recent_device_pull",
          "last_seen_at": "2026-09-26T18:46:26.000Z",
          "last_seen_age_ms": 1042000,
          "age_ms": 1042000
        },
        "queue": { "pending": 0, "inflight": 0 },
        "last_ack": { "at": null, "outcome": null },
        "diagnostics": { "androidPull": null }
      },
      "android_pull_stale_with_waiting_queue": {
        "contract_version": 1,
        "observed_at": "2026-09-26T19:03:48.000Z",
        "gmweb": { "ready": false, "reason": "task_waiting_no_device" },
        "transport": { "active": "android", "mode": "pull", "state": "stale", "reason": "no_recent_device_pull" },
        "device": {
          "state": "stale",
          "reason": "no_recent_device_pull",
          "last_seen_at": "2026-09-26T18:46:26.000Z",
          "last_seen_age_ms": 1042000,
          "age_ms": 1042000
        },
        "queue": { "pending": 14, "inflight": 0 },
        "last_ack": { "at": null, "outcome": null },
        "diagnostics": { "androidPull": null }
      },
      "android_pull_inflight_device_stale": {
        "contract_version": 1,
        "observed_at": "2026-09-26T19:03:48.000Z",
        "gmweb": { "ready": false, "reason": "inflight_device_stale" },
        "transport": { "active": "android", "mode": "pull", "state": "stale", "reason": "no_recent_device_pull" },
        "device": {
          "state": "stale",
          "reason": "no_recent_device_pull",
          "last_seen_at": "2026-09-26T18:46:26.000Z",
          "last_seen_age_ms": 1042000,
          "age_ms": 1042000
        },
        "queue": { "pending": 3, "inflight": 2 },
        "last_ack": { "at": null, "outcome": null },
        "diagnostics": { "androidPull": null }
      },
      "android_unconfigured": {
        "contract_version": 1,
        "observed_at": "2026-09-26T19:03:48.000Z",
        "gmweb": { "ready": false, "reason": "device_key_not_configured" },
        "transport": { "active": "android", "mode": "pull", "state": "unconfigured", "reason": "device_key_not_configured" },
        "device": {
          "state": "unconfigured",
          "reason": "device_key_not_configured",
          "last_seen_at": null,
          "last_seen_age_ms": null,
          "age_ms": null
        },
        "queue": { "pending": 0, "inflight": 0 },
        "last_ack": { "at": null, "outcome": null },
        "diagnostics": { "androidPull": null }
      },
      "chrome_active_with_android_diagnostics": {
        "contract_version": 1,
        "observed_at": "2026-09-26T19:03:48.000Z",
        "gmweb": { "ready": true, "reason": null },
        "transport": { "active": "chrome", "mode": null, "state": "connected", "reason": null },
        "device": {
          "state": "connected",
          "reason": null,
          "last_seen_at": null,
          "last_seen_age_ms": null,
          "age_ms": null
        },
        "queue": { "pending": 0, "inflight": 0 },
        "last_ack": { "at": null, "outcome": null },
        "diagnostics": {
          "androidPull": {
            "authoritative": false,
            "state": "stale",
            "reason": "no_recent_device_pull",
            "last_seen_at": "2026-09-26T18:46:26.000Z",
            "last_seen_age_ms": 1042000,
            "pending": 14,
            "inflight": 0
          }
        }
      }
    }
  },
  "gateway": {
    "description": "Android device bridge (transport=android, pull mode). Authenticated with the gateway device key.",
    "pull": {
      "method": "GET",
      "path": "/gateway/pull",
      "taskFields": ["requestId", "to", "text", "priority", "meta"],
      "metaIsNullForLegacySends": true,
      "revokedTasksAreNeverOffered": true
    },
    "validate": {
      "method": "POST",
      "path": "/gateway/validate",
      "request": { "requestId": "string" },
      "validResponse": { "valid": true, "status": "valid", "reason": null },
      "supersededResponse": { "valid": false, "status": "superseded", "reason": "renewed" },
      "terminalResponse": { "valid": false, "status": "terminal", "reason": "sent" },
      "unknownIdResponse": { "valid": true, "status": "valid", "reason": null, "known": false },
      "leaksTaskMetadata": false,
      "calledBefore": "submitting the task to the modem"
    },
    "ack": {
      "method": "POST",
      "path": "/gateway/ack",
      "outcomes": ["sent", "failed", "superseded"],
      "legacyBodySupported": "{requestId, ok} - outcome is derived from ok when omitted",
      "supersededSemantics": [
        "terminal",
        "not successful",
        "not billable",
        "not retryable",
        "not a gateway/device failure"
      ],
      "lateRealSendIsAuditedAs": "sent_after_revocation"
    }
  },
  "lifecycleMetrics": [
    "sms_invalidations_total",
    "sms_jobs_superseded_total",
    "sms_inflight_revoked_total",
    "sms_sent_after_revocation_total",
    "sms_validation_requests_total",
    "sms_validation_invalid_total",
    "sms_stale_generation_rejections_total",
    "sms_queue_removal_failures_total"
  ],
  "metricsEndpoint": "GET /admin/overview (master token) -> metrics",
  "errorResponse": {
    "fields": [
      "error",
      "message",
      "reason",
      "limits",
      "used"
    ],
    "rateLimitStatus": 429,
    "retryAfterHeader": "Retry-After"
  }
}
