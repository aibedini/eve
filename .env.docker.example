DOMAIN=panel.example.com
SSL_MODE=http
LETSENCRYPT_EMAIL=admin@example.com
EVE_IMAGE=ghcr.io/aibedini/eve:latest
POSTGRES_PASSWORD=change-this-long-random-password
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=auto-generated-on-install

# Optional tuning
# Leave empty for RAM-aware sizing: 1 (<6 GiB), 2 (<12 GiB), otherwise 3.
GUNICORN_WORKERS=
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=120
SESSION_COOKIE_SECURE=true

# Read-only machine API for GOD AI (EVE Context API v1). Key issuance is CLI-only:
#   python scripts/create_machine_api_key.py --name god-ai --scope context.customer.read
EVE_MACHINE_API_ENABLED=true
# Shared pepper for phone_hash lookups (HMAC-SHA256). At least 16 characters and
# identical in EVE and GOD AI; never commit a real value.
MACHINE_PHONE_PEPPER=
# Signed eve.* event push (HMAC-SHA256(timestamp.deliveryId.body)); secret >= 32 chars.
GOD_AI_BASE_URL=
GOD_AI_EVENTS_SECRET=
